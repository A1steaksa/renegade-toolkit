{
    "name": "renegade-toolkit",
    "displayName": "Renegade Porting Toolkit",
    "description": "Creates class files for C&C Renegade in Garry's Mod",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:lua",
        "onLanguage:cpp",
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "renegade-toolkit.addClassImport",
                "title": "Adds a class import to a Lua file"
            },
            {
                "command": "renegade-toolkit.addEnumImport",
                "title": "Adds an enum import to a Lua file"
            },

            
            {
                "command": "renegade-toolkit.createClass",
                "title": "Create New Class"
            },
            {
                "command": "renegade-toolkit.createClassFromJson",
                "title": "Create New Class from Json"
            },

            
            {
                "command": "renegade-toolkit.debug",
                "title": "Run Renegade Debug"
            },
            

            {
                "command": "renegade-toolkit.switchToHeader",
                "title": "Switch to Header",
                "icon": "./resources/switch-to-header-icon.svg",
                "enablement": "renegade-toolkit.enableSwitchToHeader"
            },
            {
                "command": "renegade-toolkit.switchToCpp",
                "title": "Switch to C++",
                "icon": "./resources/switch-to-c-icon.svg",
                "enablement": "renegade-toolkit.enableSwitchToCpp"
            },
            {
                "command": "renegade-toolkit.switchToLua",
                "title": "Switch to Lua",
                "icon": "./resources/switch-to-lua-icon.svg",
                "enablement": "renegade-toolkit.enableSwitchToLua"
            }
        ],

        "menus": {
            "editor/title":[
                {
                    "command": "renegade-toolkit.switchToHeader",
                    "group": "navigation",
                    "when": "renegade-toolkit.showSwitchToHeader"
                },
                {
                    "command": "renegade-toolkit.switchToCpp",
                    "group": "navigation",
                    "when": "renegade-toolkit.showSwitchToCpp"
                },
                {
                    "command": "renegade-toolkit.switchToLua",
                    "group": "navigation",
                    "when": "renegade-toolkit.showSwitchToLua"
                }
            ]
        },
        "submenus": [
            {
                "id": "renegade-toolkit.switchToLuaSubmenu",
                "label": "Lua files implementing this file"
            }
        ],

        "configuration": {
            "title": "Renegade Porting Toolkit Configuration",
            "properties": {
                "renegade-toolkit.CppWorkspaceFolderName": {
                    "order": 1,
                    "type": "string",
                    "default" : "CnC_Renegade",
                    "markdownDescription": "The name of the VSCode workspace folder that contains the project's C++ components"
                },
                "renegade-toolkit.CppCodeRoot": {
                    "order": 2,
                    "type": "string",
                    "default" : "",
                    "markdownDescription": "The path from the C++ Workspace directory to the directory containing the `Code/` directory"
                },
                "renegade-toolkit.LuaWorkspaceFolderName": {
                    "order": 3,
                    "type": "string",
                    "default" : "renegade",
                    "markdownDescription": "The name of the VSCode workspace folder that contains the project's Lua components"
                },
                "renegade-toolkit.LuaAddonPath": {
                    "order": 4,
                    "type": "string",
                    "default" : "renegade/lua/renegade",
                    "markdownDescription": "The path from the `garrysmod/` directory to the lua directory containing the Renegade `code/` directory"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.107.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0"
    },
    "dependencies": {
        "handlebars": "^4.7.8"
    }
}