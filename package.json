{
    "name": "renegade-toolkit",
    "displayName": "Renegade Porting Toolkit",
    "description": "Creates class files for C&C Renegade in Garry's Mod",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:lua",
        "onLanguage:cpp"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "renegade-toolkit.importScanLuaFiles",
                "title": "Scan Lua files for importable classes and libraries"
            },
            {
                "command": "renegade-toolkit.createClass",
                "title": "Create New Class"
            },
            {
                "command": "renegade-toolkit.createClassFromJson",
                "title": "Create New Class from Json"
            },
            {
                "command": "renegade-toolkit.debug",
                "title": "Run Renegade Debug"
            }
        ],
        "configuration": {
            "title": "Renegade Porting Toolkit Configuration",
            "properties": {
                "renegade-toolkit.LuaPath": {
                    "type": "string",
                    "default" : "./",
                    "description": "The path where the project's Lua files are located.  This directory should end with 'lua/'"
                },
                "renegade-toolkit.CppPath": {
                    "type": "string",
                    "default" : "./",
                    "description": "The path where the project's C++ files are located.  This directory should contain a directory called 'Code'"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.107.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0"
    },
    "dependencies": {
        "handlebars": "^4.7.8"
    }
}